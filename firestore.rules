rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read and write their own data:
    // users/{uid}/profile, users/{uid}/progress, users/{uid}/certs (and certificate file chunks).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
