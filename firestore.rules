rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    // Site admins. Keep this list in sync with ADMIN_EMAILS in firebase-config.js.
    function isAdmin() { return verified() && myEmail() in ['stewardle132@gmail.com', 'rsteward@responsiveedtx.com']; }
    function roleDoc(uid) { return /databases/$(database)/documents/roles/$(uid); }
    function hasRole(uid) { return exists(roleDoc(uid)); }
    function isChiefOf(deptId) {
      return signedIn() && hasRole(request.auth.uid)
        && get(roleDoc(request.auth.uid)).data.role == 'chief'
        && get(roleDoc(request.auth.uid)).data.deptId == deptId;
    }
    function inviteDoc() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function classDoc(classId) { return /databases/$(database)/documents/classes/$(classId); }
    function isInstructorOf(classId) {
      return verified() && exists(classDoc(classId)) && myEmail() in get(classDoc(classId)).data.instructors;
    }
    function enrolledIn(classId) {
      return verified() && exists(/databases/$(database)/documents/classMembers/$(classId + '__' + myEmail()));
    }

    // ---------- Each person's own data ----------
    // Profile, study progress, quiz activity, certificates (and file chunks).
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin() || (hasRole(uid) && isChiefOf(get(roleDoc(uid)).data.deptId));
    }

    // ---------- Rosters ----------
    // roles/{uid} = which department someone belongs to and whether they are a chief.
    match /roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isChiefOf(resource.data.deptId));
      // A verified user can join only the department their invite names, with the role it names.
      allow create: if verified() && request.auth.uid == uid && exists(inviteDoc())
        && request.resource.data.role == get(inviteDoc()).data.role
        && request.resource.data.deptId == get(inviteDoc()).data.deptId;
      allow create, update: if isAdmin();
      // Chiefs can remove members (not other chiefs) from their own department.
      allow delete: if isAdmin() || (isChiefOf(resource.data.deptId) && resource.data.role == 'member');
    }

    // invites/{email} = people added to a roster who have not signed in yet.
    match /invites/{email} {
      allow read: if isAdmin() || (verified() && myEmail() == email) || isChiefOf(resource.data.deptId);
      allow create: if isAdmin() || (isChiefOf(request.resource.data.deptId) && request.resource.data.role == 'member');
      allow update: if isAdmin() || (isChiefOf(resource.data.deptId) && isChiefOf(request.resource.data.deptId) && request.resource.data.role == 'member');
      allow delete: if isAdmin() || isChiefOf(resource.data.deptId);
    }

    match /departments/{deptId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // People who signed in but are not on a roster yet.
    match /accessRequests/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // ---------- Classes ----------
    // classes/{classId} = a class (e.g. FF I & II 2026) with a list of instructor emails.
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // classMembers/{classId}__{email} = a student admitted to a class, plus a small study summary.
    match /classMembers/{id} {
      allow read: if isAdmin() || isInstructorOf(resource.data.classId) || (verified() && resource.data.email == myEmail());
      allow create: if (isAdmin() || isInstructorOf(request.resource.data.classId))
        && id == request.resource.data.classId + '__' + request.resource.data.email;
      allow update: if isAdmin() || isInstructorOf(resource.data.classId)
        || (verified() && resource.data.email == myEmail()
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.email == resource.data.email
            && request.resource.data.className == resource.data.className);
      allow delete: if isAdmin() || isInstructorOf(resource.data.classId);
    }

    // ---------- Flagged questions ----------
    // Always visible to the admin. If a class is attached, that class's instructors can read and answer it.
    match /flags/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open'
        && (!('classId' in request.resource.data) || enrolledIn(request.resource.data.classId));
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid)
        || ('classId' in resource.data && isInstructorOf(resource.data.classId));
      allow update: if isAdmin()
        || ('classId' in resource.data && isInstructorOf(resource.data.classId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['iStatus', 'reply', 'repliedBy', 'repliedAt']));
      allow delete: if isAdmin();
    }
    // ---------- Part 107 Study Hub ----------
    // Teachers are approved by the admin. A class can have several teachers; teachers see only classes they teach.
    function p107TeacherDoc() { return /databases/$(database)/documents/p107Teachers/$(myEmail()); }
    function p107Teacher() { return verified() && exists(p107TeacherDoc()); }
    function p107ClassDoc(classId) { return /databases/$(database)/documents/p107Classes/$(classId); }
    function teachesP107Class(classId) {
      return p107Teacher() && exists(p107ClassDoc(classId))
        && (get(p107ClassDoc(classId)).data.teacherEmail == myEmail()
            || myEmail() in get(p107ClassDoc(classId)).data.get('teachers', []));
    }

    // p107Teachers/{email} = approved teachers. Teachers can see each other's names (to add co-teachers).
    match /p107Teachers/{email} {
      allow read: if isAdmin() || p107Teacher() || (verified() && myEmail() == email);
      allow write: if isAdmin();
    }
    // p107TeacherRequests/{email} = someone asking to become a teacher. Only the admin can approve.
    match /p107TeacherRequests/{email} {
      allow read: if isAdmin() || (verified() && myEmail() == email);
      allow create, update: if verified() && myEmail() == email && request.resource.data.email == email && request.resource.data.status == 'pending';
      allow delete: if isAdmin() || (verified() && myEmail() == email);
    }
    // p107Classes/{classId} = a class, the teacher who created it, and all of its teachers.
    match /p107Classes/{classId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (p107Teacher() && request.resource.data.teacherEmail == myEmail()
        && myEmail() in request.resource.data.teachers);
      allow update: if isAdmin() || (p107Teacher()
        && (resource.data.teacherEmail == myEmail() || myEmail() in resource.data.get('teachers', []))
        && request.resource.data.teacherEmail == resource.data.teacherEmail);
      allow delete: if isAdmin() || (p107Teacher() && resource.data.teacherEmail == myEmail());
    }
    // p107Roster/{classId}__{email} = a student added to a class.
    match /p107Roster/{id} {
      allow read: if isAdmin() || (verified() && (resource.data.email == myEmail()
        || resource.data.teacherEmail == myEmail() || myEmail() in resource.data.get('teachers', [])));
      allow create, update: if (isAdmin() || teachesP107Class(request.resource.data.classId))
        && id == request.resource.data.classId + '__' + request.resource.data.email;
      allow delete: if isAdmin() || (p107Teacher() && (resource.data.teacherEmail == myEmail()
        || myEmail() in resource.data.get('teachers', [])));
    }
    // p107Students/{uid} = a student's name, classes, and score summary.
    // The student reads and writes their own; their teachers and the admin can read it.
    match /p107Students/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin() || (p107Teacher() && myEmail() in resource.data.get('teachers', []));
    }
  }
}
